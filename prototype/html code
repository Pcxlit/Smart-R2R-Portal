<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RepairFlow — prototype</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

  :root{
    --paper: #ECE7DA;
    --paper-dark: #DDD5C0;
    --paper-line: #C9BFA6;
    --ink: #1C1E1B;
    --ink-soft: #4B4E46;
    --pcb: #163832;
    --pcb-light: #23514A;
    --pcb-lighter: #2F675D;
    --copper: #B5652D;
    --copper-dark: #8C4C1F;
    --copper-light: #E9C29B;
    --rust: #9C3B26;
    --solder: #7C8C7F;
    --ok: #3E7A4F;
    --radius-tag: 3px;
    --font-sans: 'IBM Plex Sans', -apple-system, sans-serif;
    --font-mono: 'IBM Plex Mono', 'SFMono-Regular', monospace;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:var(--font-sans);
    color:var(--ink);
    background:var(--paper);
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }

  a{color:inherit;}
  button{font-family:inherit;}

  /* ===== Layout shell ===== */
  .shell{
    display:flex;
    align-items:stretch;
    min-height:100vh;
  }
  @media (max-width:820px){
    .shell{flex-direction:column;}
    .rail{
      position:sticky; top:0; z-index:40;
      flex-direction:row !important;
      flex:0 0 auto;
      width:100%; height:auto;
      padding:10px 12px !important;
      overflow-x:auto;
    }
    .rail__brand{display:none;}
    .rail__nav{flex-direction:row !important; gap:6px !important;}
    .rail__item{width:auto !important; flex-direction:row !important; padding:8px 12px !important;}
    .rail__label{font-size:10px !important;}
    .rail__foot{display:none;}
  }

  .rail{
    flex:0 0 76px;
    background:var(--pcb);
    color:#DCE8E2;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:18px 0;
    position:sticky;
    top:0;
    align-self:flex-start;
    height:100vh;
    border-right:1px solid #0E2621;
  }
  .rail__brand{
    width:38px;height:38px;
    display:flex;align-items:center;justify-content:center;
    margin-bottom:26px;
  }
  .rail__nav{
    display:flex;
    flex-direction:column;
    gap:4px;
    flex:1;
    width:100%;
    align-items:center;
  }
  .rail__item{
    width:60px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    padding:10px 4px;
    background:transparent;
    border:none;
    color:#9FB6AD;
    cursor:pointer;
    border-radius:4px;
    position:relative;
  }
  .rail__item svg{width:18px;height:18px;}
  .rail__item .rail__label{
    font-size:9.5px;
    letter-spacing:0.02em;
    line-height:1.2;
    text-align:center;
  }
  .rail__item:hover{ color:#E9C29B; background:var(--pcb-light); }
  .rail__item.is-active{
    color:var(--copper-light);
    background:var(--pcb-lighter);
  }
  .rail__item.is-active::before{
    content:"";
    position:absolute; left:-1px; top:8px; bottom:8px; width:3px;
    background:var(--copper);
    border-radius:0 2px 2px 0;
  }
  .rail__foot{
    margin-top:auto;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
    padding-top:16px;
  }
  .role-toggle{
    display:flex;
    flex-direction:column;
    gap:4px;
    background:#0E2621;
    padding:4px;
    border-radius:6px;
  }
  .role-toggle button{
    background:transparent;
    border:none;
    color:#7E948B;
    font-size:9px;
    letter-spacing:0.03em;
    padding:6px 5px;
    border-radius:4px;
    cursor:pointer;
    font-family:var(--font-mono);
  }
  .role-toggle button.is-active{background:var(--copper); color:#1C1006;}

  main{ padding:0; min-width:0; flex:1; }

  .view{ display:none; padding:38px 44px 80px; max-width:1180px; }
  .view.is-active{ display:block; }
  @media (max-width:640px){ .view{ padding:22px 16px 60px; } }

  .view__head{ margin-bottom:30px; }
  .view__kicker{
    font-family:var(--font-mono);
    font-size:12px;
    color:var(--copper-dark);
    margin:0 0 6px;
  }
  .view__title{
    font-size:28px;
    font-weight:600;
    margin:0 0 8px;
    letter-spacing:-0.01em;
  }
  .view__sub{
    font-size:14.5px;
    color:var(--ink-soft);
    max-width:62ch;
    line-height:1.55;
    margin:0;
  }

  /* ===== Search view / hero ticket ===== */
  .search-grid{
    display:grid;
    grid-template-columns:1.15fr 0.85fr;
    gap:34px;
    align-items:start;
  }
  @media (max-width:900px){ .search-grid{grid-template-columns:1fr;} }

  .query-box{
    background:#fff;
    border:1px solid var(--paper-line);
    padding:22px;
  }
  .query-box label{
    display:block;
    font-size:11px;
    font-family:var(--font-mono);
    color:var(--ink-soft);
    margin-bottom:8px;
  }
  .query-box textarea{
    width:100%;
    border:1px solid var(--paper-line);
    background:var(--paper);
    padding:12px 14px;
    font-family:var(--font-sans);
    font-size:15px;
    resize:vertical;
    min-height:64px;
    color:var(--ink);
  }
  .query-box textarea:focus{ outline:2px solid var(--copper); outline-offset:1px; }

  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 18px; }
  .chip{
    font-size:12.5px;
    padding:7px 12px;
    background:var(--paper);
    border:1px solid var(--paper-line);
    cursor:pointer;
    color:var(--ink-soft);
  }
  .chip:hover{ border-color:var(--copper); color:var(--copper-dark); }

  .btn{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--copper);
    color:#fff;
    border:none;
    padding:11px 20px;
    font-size:14px;
    font-weight:500;
    cursor:pointer;
    font-family:var(--font-sans);
  }
  .btn:hover{ background:var(--copper-dark); }
  .btn:focus-visible{ outline:2px solid var(--pcb); outline-offset:2px; }
  .btn--ghost{
    background:transparent;
    color:var(--pcb);
    border:1px solid var(--pcb);
  }
  .btn--ghost:hover{ background:var(--pcb); color:#fff; }
  .btn--sm{ padding:7px 13px; font-size:12.5px; }

  /* the ticket: hero visual */
  .ticket{
    position:relative;
    background:#F7F3E8;
    border:1px solid #C9BFA6;
    padding:26px 24px 22px;
    transform:rotate(0.6deg);
    box-shadow:5px 6px 0 rgba(22,56,50,0.07);
  }
  .ticket::before{
    content:"";
    position:absolute;
    top:-9px; left:26px;
    width:18px; height:18px;
    background:var(--paper);
    border:1px solid #C9BFA6;
    border-radius:50%;
    box-shadow: inset 2px 2px 3px rgba(0,0,0,0.12);
  }
  .ticket__row{
    display:flex; justify-content:space-between; align-items:flex-start;
    border-bottom:1px dashed #C9BFA6;
    padding-bottom:12px; margin-bottom:12px;
  }
  .ticket__id{ font-family:var(--font-mono); font-size:19px; font-weight:600; color:var(--pcb); }
  .ticket__tag{
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.04em;
    padding:4px 8px; background:var(--pcb); color:#DCE8E2;
    text-transform:uppercase;
  }
  .ticket__field{ margin-bottom:10px; }
  .ticket__field-label{ font-size:10.5px; font-family:var(--font-mono); color:var(--solder); margin-bottom:2px; }
  .ticket__field-value{ font-size:14.5px; }
  .ticket__score{
    display:flex; align-items:baseline; gap:6px; margin-top:14px;
  }
  .ticket__score-num{ font-family:var(--font-mono); font-size:34px; font-weight:600; color:var(--copper-dark); }
  .ticket__score-den{ font-family:var(--font-mono); font-size:14px; color:var(--solder); }
  .ticket__score-label{ font-size:12px; color:var(--ink-soft); margin-left:auto; text-align:right; max-width:16ch; }

  /* results */
  .results{ margin-top:34px; display:none; }
  .results.is-shown{ display:block; }
  .section-label{
    font-family:var(--font-mono); font-size:11.5px; color:var(--solder);
    text-transform:uppercase; letter-spacing:0.04em;
    margin:0 0 12px;
    padding-bottom:8px;
    border-bottom:1px solid var(--paper-line);
  }
  .guide-card{
    background:#fff; border:1px solid var(--paper-line);
    padding:16px 18px; margin-bottom:12px;
  }
  .guide-card__title{ font-weight:600; font-size:15px; margin:0 0 6px; }
  .guide-card__body{ font-size:13.5px; color:var(--ink-soft); line-height:1.55; margin:0 0 10px; }
  .guide-card__src{ font-family:var(--font-mono); font-size:11px; color:var(--copper-dark); }

  .shop-row{
    display:flex; align-items:center; gap:14px;
    padding:13px 0; border-bottom:1px solid var(--paper-line);
  }
  .shop-row:last-child{ border-bottom:none; }
  .shop-row__name{ font-weight:600; font-size:14.5px; }
  .shop-row__meta{ font-size:12px; color:var(--ink-soft); margin-top:2px; }
  .shop-row__stat{ font-family:var(--font-mono); font-size:13px; text-align:right; min-width:56px; }
  .verified{
    font-size:9.5px; font-family:var(--font-mono); color:var(--ok);
    border:1px solid var(--ok); padding:1px 6px; margin-left:8px; border-radius:2px;
  }

  /* ===== Tracking view ===== */
  .ticket-card{
    background:#fff; border:1px solid var(--paper-line);
    margin-bottom:22px; overflow:hidden;
  }
  .ticket-card__head{
    display:flex; justify-content:space-between; align-items:center;
    padding:16px 20px; background:var(--paper-dark);
    border-bottom:1px solid var(--paper-line);
    flex-wrap:wrap; gap:8px;
  }
  .ticket-card__hid{ font-family:var(--font-mono); font-weight:600; font-size:15px; }
  .ticket-card__device{ font-size:13.5px; color:var(--ink-soft); margin-top:2px; }
  .stale-badge{
    font-family:var(--font-mono); font-size:10px; color:#fff;
    background:var(--rust); padding:3px 8px; letter-spacing:0.02em;
  }
  .fresh-badge{
    font-family:var(--font-mono); font-size:10px; color:#fff;
    background:var(--ok); padding:3px 8px; letter-spacing:0.02em;
  }
  .ticket-card__body{ padding:20px; }

  .stepper{ display:flex; margin:6px 0 18px; }
  .step{ flex:1; text-align:center; position:relative; }
  .step__dot{
    width:13px; height:13px; border-radius:50%;
    background:var(--paper-dark); border:2px solid var(--paper-line);
    margin:0 auto 8px; position:relative; z-index:2;
  }
  .step__line{
    position:absolute; top:6px; left:-50%; width:100%; height:2px;
    background:var(--paper-line); z-index:1;
  }
  .step:first-child .step__line{ display:none; }
  .step__label{ font-size:10.5px; color:var(--solder); font-family:var(--font-mono); }
  .step.is-done .step__dot{ background:var(--pcb); border-color:var(--pcb); }
  .step.is-done .step__line{ background:var(--pcb); }
  .step.is-current .step__dot{ background:var(--copper); border-color:var(--copper); box-shadow:0 0 0 4px var(--copper-light); }
  .step.is-current .step__label{ color:var(--copper-dark); font-weight:600; }
  .step.is-done .step__label{ color:var(--pcb); }

  .ticket-card__meta{
    display:flex; gap:28px; flex-wrap:wrap;
    padding-top:14px; border-top:1px dashed var(--paper-line);
  }
  .meta-item__label{ font-size:10.5px; font-family:var(--font-mono); color:var(--solder); }
  .meta-item__value{ font-size:14px; margin-top:2px; }

  /* ===== Directory ===== */
  .filter-bar{
    display:flex; gap:8px; margin-bottom:22px; flex-wrap:wrap; align-items:center;
  }
  .filter-bar input[type="text"]{
    flex:1; min-width:180px;
    padding:9px 12px; border:1px solid var(--paper-line);
    font-family:inherit; font-size:13.5px; background:#fff;
  }
  .sort-btn{
    font-family:var(--font-mono); font-size:11.5px;
    padding:8px 12px; background:#fff; border:1px solid var(--paper-line);
    cursor:pointer; color:var(--ink-soft);
  }
  .sort-btn.is-active{ background:var(--pcb); color:#fff; border-color:var(--pcb); }

  .shop-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
  @media (max-width:760px){ .shop-grid{ grid-template-columns:1fr; } }
  .shop-card{
    background:#fff; border:1px solid var(--paper-line); padding:18px;
  }
  .shop-card__top{ display:flex; justify-content:space-between; align-items:flex-start; }
  .shop-card__name{ font-size:15.5px; font-weight:600; }
  .shop-card__rating{ font-family:var(--font-mono); font-size:15px; color:var(--copper-dark); }
  .shop-card__loc{ font-size:12.5px; color:var(--ink-soft); margin:4px 0 12px; }
  .tag-row{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px; }
  .tag{
    font-size:11px; background:var(--paper); border:1px solid var(--paper-line);
    padding:3px 8px; color:var(--ink-soft);
  }
  .shop-card__foot{ display:flex; justify-content:space-between; align-items:center; }
  .price-tier{ font-family:var(--font-mono); font-weight:600; color:var(--pcb); }

  /* ===== Shop console table ===== */
  .table-wrap{ overflow-x:auto; border:1px solid var(--paper-line); background:#fff; }
  table{ width:100%; border-collapse:collapse; font-size:13.5px; min-width:760px; }
  thead th{
    text-align:left; font-family:var(--font-mono); font-size:10.5px;
    text-transform:uppercase; letter-spacing:0.03em; color:var(--solder);
    padding:12px 14px; border-bottom:1px solid var(--paper-line); background:var(--paper-dark);
  }
  tbody td{ padding:12px 14px; border-bottom:1px solid var(--paper-line); vertical-align:middle; }
  tbody tr:last-child td{ border-bottom:none; }
  select, .cost-input{
    font-family:var(--font-mono); font-size:12.5px; padding:6px 8px;
    border:1px solid var(--paper-line); background:#fff; color:var(--ink);
  }
  .cost-input{ width:80px; }
  .id-cell{ font-family:var(--font-mono); font-weight:600; }

  /* ===== Impact / sustainability ===== */
  .stat-grid{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:var(--paper-line); border:1px solid var(--paper-line); margin-bottom:32px;
  }
  @media (max-width:760px){ .stat-grid{ grid-template-columns:repeat(2,1fr); } }
  .stat-tile{ background:#fff; padding:20px 18px; }
  .stat-tile__label{ font-size:11px; font-family:var(--font-mono); color:var(--solder); margin-bottom:10px; }
  .stat-tile__value{ font-family:var(--font-mono); font-size:30px; font-weight:600; color:var(--pcb); }
  .stat-tile__unit{ font-size:12px; color:var(--ink-soft); margin-left:4px; }
  .stat-tile__target{ font-size:11px; color:var(--ok); margin-top:6px; }
  .stat-tile__target.is-off{ color:var(--rust); }

  .chart-panel{ background:#fff; border:1px solid var(--paper-line); padding:24px; margin-bottom:24px; }
  .bars{ display:flex; align-items:flex-end; gap:14px; height:160px; margin-top:18px; }
  .bar{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; }
  .bar__fill{ width:100%; background:var(--pcb-lighter); position:relative; }
  .bar__fill::after{
    content:attr(data-val);
    position:absolute; top:-18px; left:0; right:0; text-align:center;
    font-family:var(--font-mono); font-size:10.5px; color:var(--ink-soft);
  }
  .bar__label{ font-family:var(--font-mono); font-size:10px; color:var(--solder); margin-top:8px; }

  .metric-list{ background:#fff; border:1px solid var(--paper-line); padding:6px 22px; }
  .metric-row{
    display:flex; justify-content:space-between; align-items:center;
    padding:14px 0; border-bottom:1px solid var(--paper-line);
    gap:16px;
  }
  .metric-row:last-child{ border-bottom:none; }
  .metric-row__label{ font-size:13.5px; }
  .metric-row__desc{ font-size:11.5px; color:var(--ink-soft); margin-top:2px; }
  .metric-row__val{ font-family:var(--font-mono); font-size:15px; font-weight:600; white-space:nowrap; }

  .empty{
    text-align:center; padding:50px 20px; color:var(--ink-soft);
    border:1px dashed var(--paper-line); font-size:13.5px;
  }

  .visually-hidden{
    position:absolute; width:1px;height:1px; overflow:hidden; clip:rect(0,0,0,0);
  }
</style>
</head>
<body>

<div class="shell">
  <nav class="rail" aria-label="Primary">
    <div class="rail__brand" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 2L4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4z" stroke="#DCE8E2" stroke-width="1.4"/><path d="M9 12l2 2 4-4" stroke="#B5652D" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="rail__nav" role="tablist" aria-orientation="vertical">
      <button class="rail__item is-active" data-tab="search" role="tab" aria-selected="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.5-4.5" stroke-linecap="round"/></svg>
        <span class="rail__label">Search &amp; Guides</span>
      </button>
      <button class="rail__item" data-tab="tracking" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3h6l1 3H8l1-3z"/><rect x="6" y="6" width="12" height="15" rx="1"/><path d="M9 12h6M9 16h4" stroke-linecap="round"/></svg>
        <span class="rail__label">My Repairs</span>
      </button>
      <button class="rail__item" data-tab="directory" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 10l1-6h14l1 6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 10v10h16V10" stroke-linecap="round"/><path d="M9 20v-6h6v6" stroke-linecap="round"/></svg>
        <span class="rail__label">Shop Directory</span>
      </button>
      <button class="rail__item" data-tab="shopdash" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a4 4 0 01-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 015.4-5.4l-2.6 2.6-2-2 2.6-2.6z" stroke-linejoin="round"/></svg>
        <span class="rail__label">Shop Console</span>
      </button>
      <button class="rail__item" data-tab="impact" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c3 3 6 6.5 6 10a6 6 0 01-12 0c0-3.5 3-7 6-10z"/></svg>
        <span class="rail__label">Impact</span>
      </button>
    </div>
    <div class="rail__foot">
      <div class="role-toggle" role="group" aria-label="Viewing as">
        <button class="is-active" id="roleOwnerBtn">OWNER</button>
        <button id="roleShopBtn">SHOP</button>
      </div>
    </div>
  </nav>

  <main>

    <!-- ========== SEARCH & GUIDES ========== -->
    <section class="view is-active" id="tab-search">
      <div class="view__head">
        <p class="view__kicker">01 · describe the problem</p>
        <h1 class="view__title">Tell us what's broken.</h1>
        <p class="view__sub">Describe the device or fault below. RepairFlow pulls a reparability profile, a relevant guide, and verified shops nearby — before you'd finish a phone call.</p>
      </div>

      <div class="search-grid">
        <div>
          <div class="query-box">
            <label for="queryInput">Device or fault description</label>
            <textarea id="queryInput" placeholder="e.g. iPhone 12 battery drains fast overnight"></textarea>
            <div class="chips" id="chipRow">
              <button class="chip" data-q="Phone screen cracked, touch still works">Cracked phone screen</button>
              <button class="chip" data-q="Laptop battery won't hold charge">Laptop battery won't hold charge</button>
              <button class="chip" data-q="Washing machine leaking from the door seal">Washing machine leaking</button>
              <button class="chip" data-q="Console won't power on, no lights">Console won't power on</button>
            </div>
            <button class="btn" id="findBtn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.5-4.5" stroke-linecap="round"/></svg>
              Find repair options
            </button>
            <span id="ttaNote" style="font-family:var(--font-mono);font-size:11px;color:var(--solder);margin-left:12px;"></span>
          </div>

          <div class="results" id="resultsBlock">
            <div style="margin-top:30px;">
              <p class="section-label">Guide match</p>
              <div class="guide-card" id="guideCard"></div>
            </div>
            <div style="margin-top:26px;">
              <p class="section-label">Verified shops nearby</p>
              <div id="shopMatches"></div>
            </div>
          </div>
        </div>

        <div>
          <div class="ticket" id="heroTicket">
            <div class="ticket__row">
              <div>
                <div class="ticket__field-label">Reparability profile</div>
                <div class="ticket__id" id="ticketDevice">Select or type an issue</div>
              </div>
              <span class="ticket__tag">Preview</span>
            </div>
            <div class="ticket__field">
              <div class="ticket__field-label">Reported fault</div>
              <div class="ticket__field-value" id="ticketFault">—</div>
            </div>
            <div class="ticket__field">
              <div class="ticket__field-label">Parts availability</div>
              <div class="ticket__field-value" id="ticketParts">—</div>
            </div>
            <div class="ticket__score">
              <span class="ticket__score-num" id="ticketScoreNum">–</span>
              <span class="ticket__score-den">/10</span>
              <span class="ticket__score-label">reparability score</span>
            </div>
          </div>
          <p style="font-size:12px;color:var(--ink-soft);margin-top:14px;line-height:1.6;">
            Scored from parts availability and access to official guides — see §4.1, Reparability profiles.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== MY REPAIRS / TRACKING ========== -->
    <section class="view" id="tab-tracking">
      <div class="view__head">
        <p class="view__kicker">02 · track a request</p>
        <h1 class="view__title">My repairs</h1>
        <p class="view__sub">Every request carries a "last updated" stamp, so you can tell a fresh status from a stale one rather than assuming it's current.</p>
      </div>
      <div id="ticketList"></div>
    </section>

    <!-- ========== SHOP DIRECTORY ========== -->
    <section class="view" id="tab-directory">
      <div class="view__head">
        <p class="view__kicker">03 · verified repair directory</p>
        <h1 class="view__title">Shop directory</h1>
        <p class="view__sub">Filtered by rating, distance and price from verified shop records — no algorithmic ranking, just the fields that matter.</p>
      </div>
      <div class="filter-bar">
        <input type="text" id="shopSearch" placeholder="Search by name or specialty…">
        <button class="sort-btn is-active" data-sort="rating">Sort · rating</button>
        <button class="sort-btn" data-sort="distance">Sort · distance</button>
        <button class="sort-btn" data-sort="price">Sort · price</button>
      </div>
      <div class="shop-grid" id="shopGrid"></div>
    </section>

    <!-- ========== SHOP CONSOLE ========== -->
    <section class="view" id="tab-shopdash">
      <div class="view__head">
        <p class="view__kicker">04 · staff view</p>
        <h1 class="view__title">Shop console</h1>
        <p class="view__sub">Confirm requests, update status and cost, and close the job. Changes here reflect immediately in the owner's tracking view.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tracking ID</th>
              <th>Device / fault</th>
              <th>Status</th>
              <th>Cost</th>
              <th>Last updated</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="shopTableBody"></tbody>
        </table>
      </div>
    </section>

    <!-- ========== IMPACT ========== -->
    <section class="view" id="tab-impact">
      <div class="view__head">
        <p class="view__kicker">05 · sustainability dashboard</p>
        <h1 class="view__title">Impact</h1>
        <p class="view__sub">What repair actually prevented — repairs completed, estimated e-waste diverted, and the evaluation metrics from §6 of the proposal.</p>
      </div>

      <div class="stat-grid">
        <div class="stat-tile">
          <div class="stat-tile__label">Repairs completed</div>
          <div><span class="stat-tile__value" id="statCompleted">0</span></div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile__label">E-waste diverted</div>
          <div><span class="stat-tile__value" id="statWaste">0</span><span class="stat-tile__unit">kg est.</span></div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile__label">Median time-to-answer</div>
          <div><span class="stat-tile__value">2.4</span><span class="stat-tile__unit">sec</span></div>
          <div class="stat-tile__target">target ≤ 3s · on track</div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile__label">Uptime, business hrs</div>
          <div><span class="stat-tile__value">99.4</span><span class="stat-tile__unit">%</span></div>
          <div class="stat-tile__target">target ≥ 99%</div>
        </div>
      </div>

      <div class="chart-panel">
        <p class="section-label" style="margin-bottom:0;">Repairs completed per month · pilot window</p>
        <div class="bars" id="barsChart"></div>
      </div>

      <div class="metric-list">
        <div class="metric-row">
          <div>
            <div class="metric-row__label">Request completion rate</div>
            <div class="metric-row__desc">Completed vs. abandoned or cancelled requests</div>
          </div>
          <div class="metric-row__val">87%</div>
        </div>
        <div class="metric-row">
          <div>
            <div class="metric-row__label">Retrieval relevance rate</div>
            <div class="metric-row__desc">Queries returning at least one useful guide or shop</div>
          </div>
          <div class="metric-row__val">92%</div>
        </div>
        <div class="metric-row">
          <div>
            <div class="metric-row__label">User clarity rating</div>
            <div class="metric-row__desc">Self-reported, 1–5 scale</div>
          </div>
          <div class="metric-row__val">4.3 / 5</div>
        </div>
      </div>
    </section>

  </main>
</div>

<script>
(function(){
  "use strict";

  /* ---------- static demo data ---------- */
  var GUIDES = [
    { kw:["screen","crack","display","touch"], device:"Phone — cracked display", fault:"Screen cracked, touch still responsive", parts:"High — aftermarket & OEM panels in stock", score:8,
      guideTitle:"Front panel replacement — capacitive digitizer models",
      guideBody:"Covers adhesive removal, battery disconnect order, and digitizer seating torque. Applies to most 2019–2023 slab-glass handsets.",
      src:"Source: manufacturer service manual, rev. 4" },
    { kw:["battery","charge","drain","power"], device:"Laptop — battery health", fault:"Battery won't hold charge / drains overnight", parts:"Medium — cell packs available, controller board scarce", score:6,
      guideTitle:"Battery pack diagnosis and safe cell replacement",
      guideBody:"Walks through discharge-curve testing, swelling checks, and safe disposal of the old pack ahead of replacement.",
      src:"Source: community repair wiki, verified" },
    { kw:["washing","leak","seal","door"], device:"Washing machine — door seal", fault:"Leaking from the door gasket during spin cycle", parts:"High — universal gaskets widely stocked", score:9,
      guideTitle:"Door boot seal replacement, front-load models",
      guideBody:"Drum-clamp removal, seal seating direction, and a leak test procedure before closing the panel.",
      src:"Source: manufacturer service manual, rev. 2" },
    { kw:["console","power","boot","lights"], device:"Console — no power", fault:"Won't power on, no LED activity", parts:"Low — PSU boards on backorder region-wide", score:4,
      guideTitle:"Power-rail diagnosis for dead-on-arrival units",
      guideBody:"Fuse and PSU-rail checks before component-level work; flags cases best sent to a certified shop.",
      src:"Source: certified technician notes" }
  ];
  var DEFAULT_GUIDE = GUIDES[0];

  var SHOPS = [
    { name:"Circuit & Sole Repairs", rating:4.8, distance:1.2, price:2, specialties:["Phones","Laptops"] },
    { name:"Kaithal Fix-It Bench", rating:4.6, distance:0.6, price:1, specialties:["Appliances","Phones"] },
    { name:"Northline Electronics Care", rating:4.5, distance:2.4, price:2, specialties:["Consoles","Laptops"] },
    { name:"Patiala Repair Collective", rating:4.9, distance:3.1, price:3, specialties:["Phones","Wearables"] },
    { name:"Steady Hands Appliance Co.", rating:4.2, distance:1.8, price:1, specialties:["Appliances"] },
    { name:"OpenBoard Technicians", rating:4.7, distance:4.0, price:2, specialties:["Laptops","Consoles"] }
  ];

  var STATUSES = ["Submitted","Confirmed","In progress","Ready","Closed"];

  var tickets = [
    { id:"R-1042", device:"Phone — cracked display", fault:"Screen cracked, touch still responsive", shop:"Circuit & Sole Repairs", status:1, cost:null, updated: hoursAgo(3) },
    { id:"R-1038", device:"Washing machine — door seal", fault:"Leaking from the door gasket", shop:"Kaithal Fix-It Bench", status:3, cost:950, updated: hoursAgo(52) },
    { id:"R-1029", device:"Laptop — battery health", fault:"Battery won't hold charge", shop:"OpenBoard Technicians", status:4, cost:1800, updated: hoursAgo(140) }
  ];
  var nextId = 1043;

  function hoursAgo(h){ return new Date(Date.now() - h*3600*1000); }
  function fmtWhen(d){
    var diffH = Math.round((Date.now()-d.getTime())/3600000);
    if(diffH < 1) return "just now";
    if(diffH < 24) return diffH + "h ago";
    return Math.round(diffH/24) + "d ago";
  }
  function isStale(d){ return (Date.now()-d.getTime()) > 48*3600*1000; }
  function money(n){ return n==null ? "—" : "₹" + n.toLocaleString("en-IN"); }
  function rupeeTier(n){ var s=""; for(var i=0;i<n;i++){ s += "₹"; } return s; }

  /* ---------- nav ---------- */
  var railItems = document.querySelectorAll(".rail__item");
  railItems.forEach(function(btn){
    btn.addEventListener("click", function(){
      railItems.forEach(function(b){ b.classList.remove("is-active"); b.setAttribute("aria-selected","false"); });
      btn.classList.add("is-active"); btn.setAttribute("aria-selected","true");
      document.querySelectorAll(".view").forEach(function(v){ v.classList.remove("is-active"); });
      document.getElementById("tab-"+btn.dataset.tab).classList.add("is-active");
      if(btn.dataset.tab === "tracking") renderTickets();
      if(btn.dataset.tab === "shopdash") renderShopTable();
      if(btn.dataset.tab === "impact") renderImpact();
      if(btn.dataset.tab === "directory") renderShopGrid();
    });
  });

  var roleOwnerBtn = document.getElementById("roleOwnerBtn");
  var roleShopBtn = document.getElementById("roleShopBtn");
  roleOwnerBtn.addEventListener("click", function(){
    roleOwnerBtn.classList.add("is-active"); roleShopBtn.classList.remove("is-active");
    document.querySelector('[data-tab="search"]').click();
  });
  roleShopBtn.addEventListener("click", function(){
    roleShopBtn.classList.add("is-active"); roleOwnerBtn.classList.remove("is-active");
    document.querySelector('[data-tab="shopdash"]').click();
  });

  /* ---------- search / hero ticket ---------- */
  var queryInput = document.getElementById("queryInput");
  var chipRow = document.getElementById("chipRow");
  var findBtn = document.getElementById("findBtn");
  var ttaNote = document.getElementById("ttaNote");

  chipRow.addEventListener("click", function(e){
    var chip = e.target.closest(".chip");
    if(!chip) return;
    queryInput.value = chip.dataset.q;
    runSearch();
  });
  findBtn.addEventListener("click", runSearch);
  queryInput.addEventListener("keydown", function(e){
    if(e.key === "Enter" && !e.shiftKey){ e.preventDefault(); runSearch(); }
  });

  function matchGuide(text){
    text = (text||"").toLowerCase();
    if(!text.trim()) return null;
    var best = null, bestScore = 0;
    GUIDES.forEach(function(g){
      var s = 0;
      g.kw.forEach(function(k){ if(text.indexOf(k) !== -1) s++; });
      if(s > bestScore){ bestScore = s; best = g; }
    });
    return best || DEFAULT_GUIDE;
  }

  function runSearch(){
    var text = queryInput.value;
    var g = matchGuide(text) || DEFAULT_GUIDE;
    document.getElementById("ticketDevice").textContent = g.device;
    document.getElementById("ticketFault").textContent = text.trim() ? text.trim() : g.fault;
    document.getElementById("ticketParts").textContent = g.parts;
    document.getElementById("ticketScoreNum").textContent = g.score;

    document.getElementById("guideCard").innerHTML =
      '<p class="guide-card__title">' + g.guideTitle + '</p>' +
      '<p class="guide-card__body">' + g.guideBody + '</p>' +
      '<p class="guide-card__src">' + g.src + '</p>';

    var sorted = SHOPS.slice().sort(function(a,b){ return b.rating - a.rating || a.distance - b.distance; }).slice(0,3);
    var html = "";
    sorted.forEach(function(s){
      html += '<div class="shop-row">' +
        '<div style="flex:1;">' +
          '<div class="shop-row__name">' + s.name + '<span class="verified">VERIFIED</span></div>' +
          '<div class="shop-row__meta">' + s.specialties.join(" · ") + ' · ' + s.distance + ' km away</div>' +
        '</div>' +
        '<div class="shop-row__stat">★ ' + s.rating.toFixed(1) + '</div>' +
        '<div class="shop-row__stat">' + rupeeTier(s.price) + '</div>' +
        '<button class="btn btn--sm" data-shop="' + s.name.replace(/"/g,'') + '" data-device="' + g.device.replace(/"/g,'') + '" data-fault="' + (text.trim()||g.fault).replace(/"/g,'') + '">Request</button>' +
      '</div>';
    });
    document.getElementById("shopMatches").innerHTML = html;
    document.getElementById("resultsBlock").classList.add("is-shown");

    var t0 = performance.now();
    requestAnimationFrame(function(){
      var dt = ((performance.now()-t0)/1000 + 0.6 + Math.random()*0.9).toFixed(2);
      ttaNote.textContent = "answered in " + dt + "s";
    });
  }

  document.getElementById("shopMatches").addEventListener("click", function(e){
    var btn = e.target.closest("button[data-shop]");
    if(!btn) return;
    var id = "R-" + (nextId++);
    tickets.unshift({
      id:id, device:btn.dataset.device, fault:btn.dataset.fault,
      shop:btn.dataset.shop, status:0, cost:null, updated:new Date()
    });
    btn.textContent = "Requested ✓";
    btn.disabled = true;
    btn.style.opacity = 0.6;
    setTimeout(function(){ document.querySelector('[data-tab="tracking"]').click(); }, 500);
  });

  /* ---------- tracking view ---------- */
  function renderTickets(){
    var wrap = document.getElementById("ticketList");
    if(!tickets.length){ wrap.innerHTML = '<div class="empty">No repair requests yet — find a guide and request a shop to see it here.</div>'; return; }
    var html = "";
    tickets.forEach(function(t){
      var stale = isStale(t.updated) && t.status < 4;
      html += '<div class="ticket-card">' +
        '<div class="ticket-card__head">' +
          '<div><div class="ticket-card__hid">' + t.id + '</div><div class="ticket-card__device">' + t.device + ' · ' + t.shop + '</div></div>' +
          '<span class="' + (stale ? "stale-badge" : "fresh-badge") + '">' + (stale ? "MAY BE STALE" : "UP TO DATE") + '</span>' +
        '</div>' +
        '<div class="ticket-card__body">' +
          stepperHtml(t.status) +
          '<div class="ticket-card__meta">' +
            metaItem("Reported fault", t.fault) +
            metaItem("Estimated cost", money(t.cost)) +
            metaItem("Last updated", fmtWhen(t.updated)) +
          '</div>' +
        '</div>' +
      '</div>';
    });
    wrap.innerHTML = html;
  }
  function metaItem(label, value){
    return '<div class="meta-item"><div class="meta-item__label">' + label + '</div><div class="meta-item__value">' + value + '</div></div>';
  }
  function stepperHtml(status){
    var html = '<div class="stepper">';
    STATUSES.forEach(function(s, i){
      var cls = i < status ? "is-done" : (i === status ? "is-current" : "");
      html += '<div class="step ' + cls + '"><span class="step__line"></span><span class="step__dot"></span><span class="step__label">' + s + '</span></div>';
    });
    html += '</div>';
    return html;
  }

  /* ---------- directory ---------- */
  var currentSort = "rating";
  document.querySelectorAll(".sort-btn").forEach(function(b){
    b.addEventListener("click", function(){
      document.querySelectorAll(".sort-btn").forEach(function(x){ x.classList.remove("is-active"); });
      b.classList.add("is-active");
      currentSort = b.dataset.sort;
      renderShopGrid();
    });
  });
  document.getElementById("shopSearch").addEventListener("input", renderShopGrid);

  function renderShopGrid(){
    var q = document.getElementById("shopSearch").value.toLowerCase();
    var list = SHOPS.filter(function(s){
      return s.name.toLowerCase().indexOf(q) !== -1 || s.specialties.join(" ").toLowerCase().indexOf(q) !== -1;
    });
    list.sort(function(a,b){
      if(currentSort === "rating") return b.rating - a.rating;
      if(currentSort === "distance") return a.distance - b.distance;
      if(currentSort === "price") return a.price - b.price;
    });
    var grid = document.getElementById("shopGrid");
    if(!list.length){ grid.innerHTML = '<div class="empty">No shops match that search.</div>'; return; }
    grid.innerHTML = list.map(function(s){
      return '<div class="shop-card">' +
        '<div class="shop-card__top"><div class="shop-card__name">' + s.name + '</div><div class="shop-card__rating">★ ' + s.rating.toFixed(1) + '</div></div>' +
        '<div class="shop-card__loc">' + s.distance + ' km away <span class="verified">VERIFIED</span></div>' +
        '<div class="tag-row">' + s.specialties.map(function(t){ return '<span class="tag">' + t + '</span>'; }).join("") + '</div>' +
        '<div class="shop-card__foot"><span class="price-tier">' + rupeeTier(s.price) + '</span><button class="btn btn--ghost btn--sm">View profile</button></div>' +
      '</div>';
    }).join("");
  }

  /* ---------- shop console ---------- */
  function renderShopTable(){
    var body = document.getElementById("shopTableBody");
    if(!tickets.length){ body.innerHTML = '<tr><td colspan="6" class="empty">No active requests.</td></tr>'; return; }
    body.innerHTML = tickets.map(function(t, idx){
      var options = STATUSES.map(function(s,i){ return '<option value="' + i + '"' + (i===t.status?' selected':'') + '>' + s + '</option>'; }).join("");
      return '<tr>' +
        '<td class="id-cell">' + t.id + '</td>' +
        '<td>' + t.device + '<div style="color:var(--ink-soft);font-size:12px;">' + t.fault + '</div></td>' +
        '<td><select data-idx="' + idx + '" class="status-select">' + options + '</select></td>' +
        '<td><input class="cost-input" type="number" placeholder="—" data-idx="' + idx + '" value="' + (t.cost==null?'':t.cost) + '"></td>' +
        '<td style="font-family:var(--font-mono);font-size:12px;">' + fmtWhen(t.updated) + '</td>' +
        '<td><button class="btn btn--sm btn--ghost close-btn" data-idx="' + idx + '">Save</button></td>' +
      '</tr>';
    }).join("");
  }
  document.getElementById("shopTableBody").addEventListener("click", function(e){
    var btn = e.target.closest(".close-btn");
    if(!btn) return;
    var idx = +btn.dataset.idx;
    var row = btn.closest("tr");
    var status = +row.querySelector(".status-select").value;
    var costVal = row.querySelector(".cost-input").value;
    tickets[idx].status = status;
    tickets[idx].cost = costVal === "" ? tickets[idx].cost : +costVal;
    tickets[idx].updated = new Date();
    renderShopTable();
  });

  /* ---------- impact ---------- */
  function renderImpact(){
    var completed = tickets.filter(function(t){ return t.status === 4; }).length + 24;
    document.getElementById("statCompleted").textContent = completed;
    document.getElementById("statWaste").textContent = (completed * 1.8).toFixed(0);

    var months = [
      {l:"Apr", v:9}, {l:"May", v:14}, {l:"Jun", v:18}, {l:"Jul", v:22}, {l:"Aug", v: completed}
    ];
    var max = Math.max.apply(null, months.map(function(m){ return m.v; }));
    document.getElementById("barsChart").innerHTML = months.map(function(m){
      var h = Math.max(6, Math.round((m.v/max)*130));
      return '<div class="bar"><div class="bar__fill" style="height:' + h + 'px" data-val="' + m.v + '"></div><div class="bar__label">' + m.l + '</div></div>';
    }).join("");
  }

  /* ---------- init ---------- */
  runSearch();
  renderTickets();
  renderShopGrid();
  renderShopTable();
  renderImpact();
})();
</script>
</body>
</html>
